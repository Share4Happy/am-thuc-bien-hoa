# ==============================================================================
# ẨM THỰC BIÊN HÒA - APACHE / LITESPEED SECURITY & PERFORMANCE RULES
# ==============================================================================

# 1. Disable Directory Browsing (Prevent directory listing of images/data)
Options -Indexes

# 2. Block Access to Hidden & Sensitive Files (.git, .env, .htaccess, markdown)
<FilesMatch "^\.(?!well-known)">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "(^#.*#|\.(bak|conf|dist|fla|in[ci]|log|psd|sh|sql|sw[op])|~)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. Force HTTPS (SSL/TLS Encryption)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 4. Modern HTTP Security Headers
<IfModule mod_headers.c>
    # Anti-Clickjacking
    Header set X-Frame-Options "DENY"
    
    # Anti-MIME Sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # XSS Protection for legacy browsers
    Header set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Strict Transport Security (HSTS - 1 Year + Preload)
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Feature & Permissions Policy
    Header set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=(), screen-wake-lock=()"
    
    # Cross-Origin Isolation
    Header set Cross-Origin-Opener-Policy "same-origin"
    Header set Cross-Origin-Resource-Policy "same-origin"
    
    # Content Security Policy (CSP)
    Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https: blob:; connect-src 'self' https://amthucbienhoa.share4happy.com https://share4happy.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests;"
</IfModule>

# 5. Block Malicious Injection & Query Attacks (SQLi, XSS, Path Traversal)
<IfModule mod_rewrite.c>
    RewriteCond %{QUERY_STRING} (eval\(|base64_decode\(|base64_encode\(|mosConfig|GLOBALS|REQUEST) [NC,OR]
    RewriteCond %{QUERY_STRING} (boot\.ini|<script|127\.0\.0\.1|/etc/passwd) [NC,OR]
    RewriteCond %{QUERY_STRING} (\.\./|\.\.\\) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# 6. Static Asset Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
